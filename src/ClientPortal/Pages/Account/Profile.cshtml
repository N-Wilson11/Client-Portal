@page
@model ClientPortal.Pages.Account.ProfileModel
@{ ViewData["Title"] = "Mijn profiel"; }
<h1>Mijn profiel</h1>
@if (Model.StatusMessage is not null) { <div class="alert alert-success">@Model.StatusMessage</div> }
<form method="post" class="col-md-5">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">E-mail</label><input class="form-control" value="@Model.Email" disabled /></div>
    <div class="mb-3"><label asp-for="Input.FullName" class="form-label">Naam</label><input asp-for="Input.FullName" class="form-control" /><span asp-validation-for="Input.FullName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.PhoneNumber" class="form-label">Telefoon</label><input asp-for="Input.PhoneNumber" class="form-control" /><span asp-validation-for="Input.PhoneNumber" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Opslaan</button>
</form>
<p class="mt-3"><a asp-page="/Account/Subscription">Mijn abonnement</a> | <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword">Wachtwoord wijzigen</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
